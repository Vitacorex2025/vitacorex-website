{
  "headers": [
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/sign-in/",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "/app/sign-in/",
      "permanent": false
    },
    {
      "source": "/resources",
      "destination": "/insights.html",
      "permanent": true
    },
    {
      "source": "/resources.html",
      "destination": "/insights.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://docketmint.onrender.com/api/:path*"
    },
    {
      "source": "/files/:path*",
      "destination": "https://docketmint.onrender.com/files/:path*"
    },
    {
      "source": "/health",
      "destination": "https://docketmint.onrender.com/health"
    }
  ]
}