DOCKETMINT_ENV=production
DOCKETMINT_API_PREFIX=/api

# Public app / routing
DOCKETMINT_FRONTEND_URL=https://docketmint.app
DOCKETMINT_PUBLIC_APP_URL=https://docketmint.app
DOCKETMINT_PUBLIC_APP_WWW_URL=https://www.docketmint.app
DOCKETMINT_RENDER_SERVICE_URL=https://docketmint.onrender.com
DOCKETMINT_SPLIT_ORIGIN_MODE=false
DOCKETMINT_PUBLIC_API_URL=
DOCKETMINT_ALLOWED_ORIGINS=https://docketmint.app,https://www.docketmint.app

# Storage / persistence
# Leave empty in production unless you intentionally point at a mounted persistent path.
# On Render, the app will auto-prefer DOCKETMINT_RENDER_DISK_MOUNT_PATH when available.
DOCKETMINT_STORAGE_PATH=
DOCKETMINT_RENDER_DISK_MOUNT_PATH=/var/data

# Upload / external lookups
DOCKETMINT_MAX_UPLOAD_MB=25
DOCKETMINT_ENABLE_LIVE_SUNBIZ=false
DOCKETMINT_SUNBIZ_TIMEOUT_SECONDS=12

# HMAC signing key — CRITICAL. Used for private-lookup session tokens AND DocketMint session cookies.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Never use the placeholder. Set this in Render environment variables, not in a committed file.
DOCKETMINT_SECRET_KEY=generate_a_strong_random_hex_64_char_value

# Session cookies
DOCKETMINT_SESSION_COOKIE_NAME=docketmint_session
DOCKETMINT_SESSION_COOKIE_DOMAIN=
DOCKETMINT_SESSION_COOKIE_SECURE=
DOCKETMINT_SESSION_COOKIE_SAMESITE=

# Admin bootstrap via secrets only
DOCKETMINT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
DOCKETMINT_BOOTSTRAP_ADMIN_PASSWORD=change_me_in_secret_manager

# Production enforcement
DOCKETMINT_ENFORCE_ADMIN_ONLY_CASE_CREATION=true
DOCKETMINT_ENFORCE_ADMIN_ONLY_PACKET_GENERATION=true

# Commercial defaults
DOCKETMINT_DEFAULT_PLAN=auto

# Logging
DOCKETMINT_LOG_LEVEL=INFO

# VitaCoreX public intake / CRM routing
VITACOREX_PUBLIC_BASE_URL=https://vitacorexllc.com
VITACOREX_CRM_WEBHOOK_URL=
VITACOREX_CRM_WEBHOOK_TOKEN=
VITACOREX_ALERT_WEBHOOK_URL=
VITACOREX_RATE_LIMIT_PER_10_MIN=8

# ── Private Lookup Tool ────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# NOTE: STRIPE_WEBHOOK_SECRET is configured but no webhook endpoint is currently implemented.
# Payment verification uses client-side verify-payment (redirect + Stripe session retrieval).
# Webhook handling is planned for v2. Set this when a /webhook endpoint is added.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs
STRIPE_LOOKUP_PRICE_ID=price_...
STRIPE_ACTION_MEMO_PRICE_ID=price_1TGRWlRyC2SuYGJbAQr45fgr
STRIPE_CONSULT_PRICE_ID=price_1TGRYRRyC2SuYGJbKckPdww8
STRIPE_PACKET_PREP_PRICE_ID=price_1TGRZtRyC2SuYGJbHAoHNGV5
STRIPE_MONITORING_PRICE_ID=price_1TGRadRyC2SuYGJb5QI5drIJ

# Pricing
VCX_LOOKUP_PRICE=14
VCX_ACTION_MEMO_PRICE=39
VCX_MONITORING_PRICE=19

# Feature flags
LOOKUP_ACCESS_ENABLED=true
ACTION_MEMO_CHECKOUT_ENABLED=true
REMINDERS_SUBSCRIPTION_ENABLED=false
PACKET_PREP_CHECKOUT_ENABLED=false
ASSISTED_PAYMENT_ENABLED=false

# PACER (federal courts)
PACER_USERNAME=
PACER_PASSWORD=

# SunPass live API (when available)
VCX_SUNPASS_API_KEY=
VCX_LEXISNEXIS_TOLLS_ENABLED=false
