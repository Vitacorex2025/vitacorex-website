
:root{--bg:#eef5fb;--bg2:#f8fbfe;--ink:#0e2036;--muted:#5b6a7f;--line:rgba(14,32,54,.10);--navy:#163656;--gold:#d6b16a;--glass:rgba(255,255,255,.58);--glass2:rgba(255,255,255,.76);--shadow:0 18px 60px rgba(7,22,42,.12);--radius:24px;--max:1220px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink);background:linear-gradient(180deg,#edf4fa 0%,#f8fbfe 55%,#edf4fa 100%);overflow-x:hidden}body.modal-open{overflow:hidden}a{text-decoration:none;color:inherit}img{display:block;max-width:100%}button,input,textarea,select{font:inherit}
.wrap{max-width:var(--max);margin:0 auto;padding:0 22px}.small-note{font-size:.86rem;line-height:1.55;color:var(--muted)}
.site-header{position:sticky;top:0;z-index:70;background:rgba(246,249,252,.68);backdrop-filter:blur(16px);border-bottom:1px solid rgba(14,32,54,.06)}
.header-shell{display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center;padding:10px 0}.brand{display:flex;align-items:center;gap:12px;min-width:0}.brand img{width:48px;height:48px;border-radius:16px;box-shadow:0 12px 24px rgba(7,22,42,.15)}.brand-title{display:flex;flex-direction:column;gap:2px}.brand-title strong{font-size:1.08rem;line-height:1}.brand-title span{font-size:.84rem;color:var(--muted)}
.main-nav{display:flex;justify-content:center;gap:6px;flex-wrap:wrap}.main-nav a{padding:9px 13px;border-radius:999px;font-size:.92rem;font-weight:650;color:#36506f;white-space:nowrap;transition:.2s ease}.main-nav a:hover,.main-nav a.active{background:rgba(255,255,255,.88);box-shadow:0 10px 24px rgba(7,22,42,.08);color:var(--navy)}
.header-tools{display:flex;align-items:flex-start;gap:10px}.clock-stack{display:flex;flex-direction:column;align-items:flex-end;gap:8px}.clock-widget{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:10px;border-radius:20px;background:linear-gradient(180deg,rgba(255,255,255,.60),rgba(255,255,255,.34));border:1px solid rgba(255,255,255,.62);backdrop-filter:blur(18px);box-shadow:var(--shadow);min-width:252px}.clock-card{padding:9px 11px;border-radius:16px;background:rgba(255,255,255,.22);border:1px solid rgba(255,255,255,.38)}.clock-label{font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:#6a7d91}.clock-time{font-size:1.14rem;font-weight:800;font-variant-numeric:tabular-nums;margin-top:3px}
.lang-row{display:flex;gap:8px;justify-content:flex-end}.lang-btn,.menu-btn{border:none;cursor:pointer}.lang-btn{min-width:44px;padding:8px 12px;border-radius:999px;background:rgba(255,255,255,.66);border:1px solid rgba(255,255,255,.76);font-weight:800;color:#32506f;transition:.2s ease}.lang-btn.active{background:linear-gradient(135deg,var(--navy),#264d77);color:#fff;box-shadow:0 10px 24px rgba(22,54,86,.18)}.menu-btn{display:none;width:44px;height:44px;border-radius:14px;background:#fff;border:1px solid rgba(255,255,255,.76);box-shadow:var(--shadow);font-size:1.25rem}.mobile-nav{display:none;padding-bottom:12px}.mobile-nav.open{display:grid;gap:8px}.mobile-nav a{padding:12px 14px;border-radius:14px;background:#fff;border:1px solid var(--line);box-shadow:0 8px 20px rgba(7,22,42,.08)}
.hero{position:relative;overflow:hidden;border-bottom:1px solid rgba(14,32,54,.06)}.hero-video{position:absolute;inset:0}.hero-video video,.hero-video img{width:100%;height:100%;object-fit:cover}.hero-video img{display:none}.hero-video::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,26,44,.34) 0%,rgba(13,28,47,.40) 42%,rgba(241,246,251,.88) 100%)}
.hero-inner{position:relative;z-index:1;padding:46px 0 12px}.hero-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:22px;align-items:stretch}.glass,.card{background:#fff;border:1px solid rgba(14,32,54,.08);border-radius:26px;box-shadow:var(--shadow)}.glass{background:linear-gradient(180deg,rgba(255,255,255,.80),rgba(255,255,255,.58));backdrop-filter:blur(18px);border-color:rgba(255,255,255,.60)}.hero-copy{padding:28px}.hero-side{display:grid;gap:14px}.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border-radius:999px;background:rgba(255,255,255,.84);box-shadow:0 10px 24px rgba(7,22,42,.08);font-size:.77rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--navy)}.eyebrow:before{content:'';width:8px;height:8px;border-radius:999px;background:var(--gold)}
h1,h2{font-family:Inter,system-ui,sans-serif}h1{font-size:clamp(2.3rem,4.2vw,4.2rem);line-height:1.02;letter-spacing:-.045em;max-width:12ch;margin:16px 0 12px;color:#0d1e34}h2{font-size:clamp(1.72rem,2.8vw,2.72rem);line-height:1.08;letter-spacing:-.035em;margin:0 0 10px;max-width:14ch}.lead{font-size:1rem;line-height:1.66;color:#31485f;max-width:64ch}.cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 20px;border-radius:999px;font-weight:750;border:1px solid transparent;cursor:pointer;transition:transform .18s ease,box-shadow .18s ease,background .18s ease}.btn:hover{transform:translateY(-1px)}.btn-primary{background:linear-gradient(135deg,var(--navy),#264d77);color:#fff;box-shadow:0 14px 28px rgba(22,54,86,.18)}.btn-secondary{background:#fff;border-color:var(--line);color:var(--navy);box-shadow:0 10px 22px rgba(7,22,42,.08)}
.stats-grid,.grid-2,.grid-3,.grid-4,.resource-grid,.careers-layout,.counter-grid,.footer-grid,.intake-wrap{display:grid;gap:16px}.stats-grid{grid-template-columns:1fr 1fr}.grid-2{grid-template-columns:1fr 1fr}.grid-3{grid-template-columns:repeat(3,1fr)}.grid-4{grid-template-columns:repeat(4,1fr)}.resource-grid{grid-template-columns:repeat(2,1fr)}.careers-layout{grid-template-columns:1fr 1fr}.footer-grid{grid-template-columns:1.2fr .8fr .8fr}.intake-wrap{grid-template-columns:1.06fr .94fr}
.stat-card,.problem-item,.card,.chart,.output-panel{padding:22px}.stat-card .top{font-size:.76rem;letter-spacing:.08em;text-transform:uppercase;color:#6b7c92}.stat-card strong{display:block;font-size:2rem;margin-top:6px}.section{padding:30px 0}.band{background:linear-gradient(180deg,rgba(255,255,255,.58),rgba(255,255,255,.12));border-top:1px solid rgba(14,32,54,.05);border-bottom:1px solid rgba(14,32,54,.05)}.section-intro,p{color:var(--muted);line-height:1.65}.section-intro{margin:0 0 16px;max-width:72ch}
.service-index{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:14px;background:#edf4fb;color:var(--navy);font-weight:800;margin-bottom:12px}.sublist{margin:12px 0 0;padding-left:18px;color:#42556c;display:grid;gap:6px}.problem-item h3,.card h3{margin:0 0 8px;font-size:1.18rem;line-height:1.18;color:#10213a}
.market-ticker{position:relative;z-index:1;margin-top:10px}.market-wrap{padding:10px 14px;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.72),rgba(255,255,255,.5));backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.62);box-shadow:var(--shadow)}.market-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:6px}.market-head strong{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:#36506f}.market-head span{font-size:.74rem;color:#72849a}.ticker-box{min-height:42px}
.bar-row{display:grid;gap:10px;margin-top:12px}.bar-row .row{display:grid;grid-template-columns:170px 1fr 60px;gap:10px;align-items:center}.bar-bg{height:11px;border-radius:999px;background:#e6eef7;overflow:hidden}.bar-fill{height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,#caa558,#f0d9a7);transition:width 1.1s ease}.counter strong{display:block;font-size:2.05rem}.counter span{display:block;margin-top:8px;color:var(--muted)}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-weight:700;font-size:.92rem;color:#1a2c44}.field input,.field select,.field textarea{width:100%;padding:14px 15px;border-radius:16px;border:1px solid rgba(14,32,54,.12);background:#fbfdff;color:var(--ink)}.field textarea{min-height:120px;resize:vertical}.output-panel{background:linear-gradient(180deg,#fff,#f7fbfe)}.out-row{display:grid;gap:5px;padding:14px 0;border-bottom:1px solid rgba(14,32,54,.08)}.out-row span{font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;color:#617489}.out-row strong{line-height:1.55}
.resource-card .meta{display:flex;gap:8px;flex-wrap:wrap}.pill{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;background:#eff5fb;color:#5a7088;font-size:.78rem;font-weight:700}.talent-list{display:grid;gap:10px;margin-top:12px}.talent-item{display:flex;gap:10px;align-items:flex-start}.talent-item:before{content:'•';color:var(--gold);font-weight:900}.footer{padding:28px 0 42px}.footer-links{display:grid;gap:10px}.footer-links a{color:#304963}.foot-social{display:flex;gap:10px;flex-wrap:wrap}
.modal{position:fixed;inset:0;background:rgba(7,18,32,.45);display:none;place-items:center;padding:18px;z-index:120}.modal.open{display:grid}.modal-card{width:min(560px,100%);padding:22px;border-radius:26px;background:linear-gradient(180deg,rgba(255,255,255,.92),rgba(255,255,255,.80));backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,.65);box-shadow:0 22px 60px rgba(7,18,32,.24)}.modal-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.modal-close{width:40px;height:40px;border-radius:14px;border:none;background:#fff;cursor:pointer;box-shadow:0 8px 20px rgba(7,22,42,.12)}.modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:10px}
.reveal{opacity:0;transform:translateY(12px);transition:.45s ease}.reveal.visible{opacity:1;transform:none}
@media (max-width:1100px){.grid-4,.footer-grid,.hero-grid,.careers-layout,.intake-wrap{grid-template-columns:1fr 1fr}.grid-3,.resource-grid,.counter-grid{grid-template-columns:1fr 1fr}}
@media (max-width:900px){.main-nav{display:none}.menu-btn{display:block}.clock-widget{grid-template-columns:1fr;min-width:170px}.hero-grid,.grid-2,.grid-3,.grid-4,.resource-grid,.footer-grid,.careers-layout,.intake-wrap,.counter-grid{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.bar-row .row{grid-template-columns:1fr}.bar-row .row strong:last-child{justify-self:end}h1{font-size:clamp(2rem,7vw,3.2rem);max-width:15ch}.hero-inner{padding-top:28px}.market-head{display:grid;gap:4px}}
@media (max-width:640px){.wrap{padding:0 16px}.header-shell{gap:10px}.brand img{width:42px;height:42px}.brand-title strong{font-size:1rem}.brand-title span{font-size:.8rem}.clock-time{font-size:1.02rem}.hero-copy,.stat-card,.problem-item,.card,.output-panel{padding:18px}.section{padding:24px 0}.btn{width:100%}}


/* v28 premium polish */
.site-header{transition:background .28s ease,border-color .28s ease,box-shadow .28s ease,padding .28s ease}
.site-header .wrap{position:relative}
.header-shell{grid-template-columns:minmax(220px,auto) auto 1fr;align-items:center;gap:18px;padding:8px 0}
.header-order{display:inline-flex;align-items:center;justify-content:center;height:42px;padding:0 18px;border-radius:999px;background:linear-gradient(135deg,var(--navy),#2d5b89);color:#fff;font-weight:750;box-shadow:0 12px 24px rgba(20,55,86,.18);white-space:nowrap}
.main-nav{justify-content:flex-start;padding:0 0 12px 78px;border-top:1px solid rgba(14,32,54,.05);margin-top:8px}
.header-tools{justify-content:flex-end}.clock-stack{margin-left:auto}.clock-widget{min-width:280px;gap:10px;padding:8px 10px}.clock-card{padding:10px 12px}.clock-topline{display:flex;justify-content:space-between;gap:8px;align-items:center}.clock-sub{font-size:.7rem;color:#7b8ca2;text-transform:uppercase;letter-spacing:.06em}
.clock-label{font-size:.72rem;letter-spacing:.07em}.clock-time{font-size:1.08rem}.lang-row{gap:6px}.lang-btn{min-width:40px;padding:7px 10px;font-size:.82rem}
.hero-inner{padding:34px 0 10px}.hero-grid{gap:18px;align-items:end}.hero-copy{padding:24px}.hero-side .problem-item,.hero-side .stat-card{padding:18px}.hero-side{gap:12px}
h1{font-size:clamp(2rem,3.2vw,3.15rem);max-width:11ch;margin:12px 0 10px}.lead{font-size:.98rem;max-width:58ch}.problem-item h3,.card h3{font-size:1.1rem}
.section{padding:24px 0}.counter-grid .card,.grid-3 .card,.grid-4 .card,.resource-card{transition:transform .24s ease,box-shadow .24s ease,border-color .24s ease}.card:hover,.resource-card:hover,.counter-grid .card:hover{transform:translateY(-2px);box-shadow:0 18px 36px rgba(7,22,42,.12);border-color:rgba(25,74,121,.16)}
.market-wrap{padding:8px 12px}.market-head{margin-bottom:4px}.market-head strong{font-size:.72rem}.market-head span{font-size:.7rem}.ticker-box{min-height:34px}
.tradingview-widget-container,.tradingview-widget-container *{pointer-events:none!important}
.attach-button{display:inline-flex;align-items:center;gap:10px;padding:12px 16px;border-radius:16px;border:1px dashed rgba(23,73,118,.24);background:#f7fbff;color:var(--navy);font-weight:700;cursor:pointer}.attach-button input{display:none}.file-list{margin-top:8px}
.btn-disabled{opacity:.55;pointer-events:none}
.site-header.header-compact{background:rgba(246,249,252,.82);box-shadow:0 10px 30px rgba(7,22,42,.08)}
.site-header.header-compact .main-nav{display:none}.site-header.header-compact .header-shell{grid-template-columns:minmax(160px,auto) auto 1fr;padding:6px 0}.site-header.header-compact .brand img{width:40px;height:40px}.site-header.header-compact .brand-title span{display:none}.site-header.header-compact .clock-widget{padding:4px 8px;min-width:214px}.site-header.header-compact .clock-card{padding:6px 8px;background:rgba(255,255,255,.17)}.site-header.header-compact .clock-label,.site-header.header-compact .clock-sub{font-size:.62rem}.site-header.header-compact .clock-time{font-size:.92rem}.site-header.header-compact .header-order{height:38px;padding:0 14px}
@media (max-width:1100px){.header-shell{grid-template-columns:minmax(180px,auto) auto 1fr}.main-nav{padding-left:0;justify-content:center}}
@media (max-width:900px){.header-shell{grid-template-columns:1fr auto;gap:10px}.header-order{display:none}.main-nav{display:none}.clock-widget{grid-template-columns:1fr 1fr;min-width:240px}.menu-btn{display:block;align-self:center}.header-tools{gap:8px}.site-header.header-compact .clock-widget{min-width:170px}.site-header.header-compact .clock-widget .clock-card:last-child{display:none}.site-header.header-compact .lang-row{justify-content:flex-end}.mobile-nav{padding-top:8px}}
@media (max-width:640px){.hero-inner{padding-top:22px}.header-shell{grid-template-columns:1fr auto}.brand-title span{display:none}.clock-widget{min-width:206px;gap:6px}.clock-card{padding:8px 9px}.clock-label{font-size:.63rem}.clock-sub{font-size:.6rem}.clock-time{font-size:.94rem}.lang-row{gap:4px}.lang-btn{padding:6px 8px;min-width:34px}.menu-btn{width:40px;height:40px}.hero-copy{padding:18px}h1{font-size:clamp(1.7rem,7vw,2.35rem);max-width:12ch}.stats-grid{grid-template-columns:1fr 1fr}.site-header.header-compact .brand img{width:34px;height:34px}.site-header.header-compact .clock-widget{min-width:auto}.site-header.header-compact .clock-topline{display:none}.site-header.header-compact .clock-time{font-size:.85rem}}

.form-status{min-height:22px;margin-top:12px}.form-status.success{color:#0f766e}.form-status.error{color:#b42318}.btn.is-loading{opacity:.7;pointer-events:none}.btn.is-loading::after{content:'…';display:inline-block;margin-left:6px}

.field input[type="file"]{padding:12px;background:#fff;line-height:1.3}.file-note{margin-top:-4px}.field input[type="file"]::file-selector-button{margin-right:12px;border:none;border-radius:12px;padding:10px 14px;background:#eaf3fb;color:#12395e;font-weight:700;cursor:pointer}

/* careers button sizing surgical fix */
#careersForm .cta-row{display:block;margin-top:18px}
#careersForm #careersSubmitBtn{width:100%;min-height:50px;padding:0 20px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px}
@media (max-width:900px){#careersForm #careersSubmitBtn{width:100%}}


/* --- VitaCoreX premium polish + alignment fixes --- */
:root{
  --lux-shadow:0 22px 64px rgba(8,25,45,.12);
  --lux-line:rgba(24,63,100,.12);
}
body.nav-open{overflow:hidden}
.section,.hero-inner,.footer-top,.footer-bottom{position:relative}
.card,.glass,.resource-card,.problem-item,.stat-card,.metric-card,.panel,.form-shell,.output-card,.timeline-card,.service-card{
  box-shadow:var(--lux-shadow);
}
.card,.glass,.resource-card,.problem-item,.stat-card,.panel,.form-shell,.output-card{
  border-color:var(--lux-line);
}
.btn,.header-order,.lang-btn,.menu-btn,.attach-button{
  transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease, background .22s ease, color .22s ease;
}
.btn:hover,.header-order:hover,.attach-button:hover{transform:translateY(-1px); box-shadow:0 16px 34px rgba(20,55,86,.16)}
.btn:focus-visible,.lang-btn:focus-visible,.menu-btn:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{
  outline:3px solid rgba(214,177,106,.26);
  outline-offset:2px;
}
.grid-3,.grid-4,.counter-grid,.resource-grid,.service-grid,[class*="grid"]{
  align-items:stretch;
}
.grid-3 > *, .grid-4 > *, .counter-grid > *, .resource-grid > *, .service-grid > *{
  min-width:0;
}
.card h3,.resource-card h3,.service-card h3{
  letter-spacing:-.015em;
}
.lead, .small-note, p{
  text-wrap:pretty;
}
.hero-copy h1, h1, h2{
  letter-spacing:-.03em;
}
.hero-copy .eyebrow,.eyebrow,.kicker{
  letter-spacing:.18em;
}
.form-grid,.grid-2,.split-grid{
  align-items:start;
}
.field input,.field textarea,.field select{
  min-height:52px;
  border-radius:16px;
  border:1px solid rgba(18,57,94,.12);
  background:rgba(255,255,255,.95);
}
.field textarea{min-height:132px}
.field input:hover,.field textarea:hover,.field select:hover{
  border-color:rgba(22,54,86,.22);
}
.main-nav a,.mobile-nav a{
  position:relative;
}
.main-nav a::after{
  content:'';
  position:absolute;
  left:14px; right:14px; bottom:7px;
  height:2px; border-radius:999px;
  background:linear-gradient(90deg, transparent, rgba(214,177,106,.9), transparent);
  opacity:0; transform:scaleX(.65);
  transition:.22s ease;
}
.main-nav a:hover::after,.main-nav a.active::after{opacity:1; transform:scaleX(1)}
.reveal{transform:translateY(14px); opacity:0; transition:transform .55s ease, opacity .55s ease}
.reveal.visible{transform:none; opacity:1}
.hero-copy,.hero-side,.resource-card,.counter-grid .card,.grid-3 .card,.grid-4 .card{
  height:100%;
}
@media (max-width:900px){
  .header-tools{align-items:center}
  .mobile-nav{
    gap:10px;
    padding:10px 0 14px;
  }
  .mobile-nav a{
    background:linear-gradient(180deg,rgba(255,255,255,.94),rgba(255,255,255,.84));
  }
}
@media (max-width:640px){
  .wrap{padding:0 16px}
  .btn,.header-order{width:100%; justify-content:center}
  .cta-row,.btn-row{
    display:grid;
    gap:10px;
  }
  .stats-grid,.counter-grid{
    grid-template-columns:1fr;
  }
}
