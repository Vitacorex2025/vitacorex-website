# =====================================================================
# vcx-api — PREVIEW environment template (committable: placeholders only)
# Copy to vcx-api/.env (gitignored) and fill the <...> values locally.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit real values. Never paste them into chat, logs or tickets.
# =====================================================================

# --- Environment ------------------------------------------------------
# preview | production. Anything other than "production" marks every
# record and message TEST and enables the mock payment provider.
VCX_ENV=preview

# --- Storage (keep runtime data OUTSIDE the repository) ---------------
VCX_DB_PATH=<absolute path>/runtime/vcx-preview.db
VCX_UPLOADS_DIR=<absolute path>/runtime/uploads
VCX_MAX_UPLOAD_MB=25
# Catalog (single source of truth). Default: ../assets/data/vcx-catalog.json
# relative to vcx-api/.
VCX_CATALOG_PATH=

# --- URLs -------------------------------------------------------------
# Public site that hosts order-status.html / quote.html
VCX_SITE_BASE=http://localhost:4646
# Public base of this API (owner-desk links in emails; mock checkout URL).
# Leave empty to use the request host for mock checkout links.
VCX_API_BASE=
# Legacy magic-link base used by the v1 intake flow
VCX_BASE_URL=http://localhost:4646

# --- CORS -------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (add LAN origin here)
VCX_ALLOWED_ORIGINS=http://localhost:4646,http://127.0.0.1:4646
# VCX_CORS_ALLOW_CREDENTIALS=true
# VCX_CORS_ALLOW_METHODS=*
# VCX_CORS_ALLOW_HEADERS=*

# --- Secrets (unset => endpoints fail closed with 503; no defaults) ----
# Owner desk (/owner) + /api/v2/owner/* + /api/review/* + /api/calendar/notify
VCX_ADMIN_TOKEN=<random secret>
# Voice (Vapi) tool endpoints: header X-VCX-Voice-Secret
VCX_VOICE_TOOL_SECRET=<random secret>
# Stripe webhook signing secret (whsec_...). In mock mode any random value:
# the mock provider signs its Stripe-shaped events with it.
VCX_STRIPE_WEBHOOK_SECRET=<random secret>
# Transcript HMAC secret (falls back to VCX_ADMIN_TOKEN; no hardcoded default)
VCX_TRANSCRIPT_SECRET=
# VCX_TRANSCRIPT_TOKEN_TTL=60

# --- Payments ---------------------------------------------------------
# mock (preview only) | stripe_test (requires sk_test_ key) |
# stripe_live (requires sk_live_ key AND VCX_ENV=production)
VCX_PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=

# --- Notifications (durable outbox) -----------------------------------
# Owner destination for request/payment notifications
VCX_OWNER_EMAIL=<owner address>
# Legacy v1 admin notifications (also used as owner fallback)
VCX_ADMIN_EMAIL=
VCX_FROM_EMAIL=noreply@vitacorexllc.com
# SMTP is used only when HOST, USER and PASS are all set. Leave empty in
# preview: messages are written as .eml files to VCX_MAIL_SINK_DIR (TEST sink).
VCX_SMTP_HOST=
VCX_SMTP_PORT=587
VCX_SMTP_USER=
VCX_SMTP_PASS=
VCX_MAIL_SINK_DIR=<absolute path>/runtime/mail-sink
# Outbox worker (background thread) and retry ceiling
VCX_OUTBOX_WORKER=true
VCX_OUTBOX_MAX_ATTEMPTS=6

# --- Rate limiting ----------------------------------------------------
VCX_RATE_LIMIT_ENABLED=true

# --- Legacy integrations (leave empty in preview) ---------------------
OPENAI_API_KEY=
# VCX_LLM_MODEL=gpt-4o-mini
# VCX_LLM_MAX_TOKENS=2000
VCX_CRM_WEBHOOK_URL=
VCX_CRM_WEBHOOK_SECRET=
