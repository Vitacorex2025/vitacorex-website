# ====================================================================
# VCX Intake OS — Environment Configuration
# ====================================================================
# Copy this file to .env and fill in values.
# All variables have sensible defaults for local development.

# --- Database -----------------------------------------------------------
# Path to SQLite database file (created on first startup)
VCX_DB_PATH=data/vcx.db

# --- File Uploads -------------------------------------------------------
# Directory where uploaded files are stored
VCX_UPLOADS_DIR=uploads
# Maximum upload size per file in MB
VCX_MAX_UPLOAD_MB=25

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed origins
# Dev (frontend 8080 + API 8787):
#   http://localhost:8080,http://localhost:8787,http://127.0.0.1:8080,http://127.0.0.1:8787
# Production: https://vitacorexllc.com,https://www.vitacorexllc.com
VCX_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8787,http://127.0.0.1:8080,http://127.0.0.1:8787
# Optional overrides (defaults are permissive for dev):
# VCX_CORS_ALLOW_CREDENTIALS=true
# VCX_CORS_ALLOW_METHODS=*
# VCX_CORS_ALLOW_HEADERS=*

# --- Authentication -----------------------------------------------------
# Admin token for /api/review/* endpoints (change this in production!)
VCX_ADMIN_TOKEN=change-me

# --- Base URL -----------------------------------------------------------
# Used for building magic links and portal URLs in emails
VCX_BASE_URL=https://vitacorexllc.com

# --- Email (SMTP) -------------------------------------------------------
# All SMTP vars must be set for email delivery to work.
# If any are missing, emails are skipped with a warning log.
# Example for Gmail: host=smtp.gmail.com, port=587, user=you@gmail.com
VCX_SMTP_HOST=
VCX_SMTP_PORT=587
VCX_SMTP_USER=
VCX_SMTP_PASS=
# Admin email receives intake notifications
VCX_ADMIN_EMAIL=
# From address on outgoing emails
VCX_FROM_EMAIL=noreply@vitacorexllc.com

# --- Transcript Security ------------------------------------------------
# HMAC signing key for transcript access tokens.
# Falls back to VCX_ADMIN_TOKEN if not set.
# VCX_TRANSCRIPT_SECRET=
# Default token lifetime in minutes (1-1440). Default: 60
# VCX_TRANSCRIPT_TOKEN_TTL=60

# --- AI / OpenAI --------------------------------------------------------
# Required for: AI contract generation, review comments, legal assistant streaming.
# Without this key, these features fall back to rule-based (non-AI) mode.
OPENAI_API_KEY=
# Model to use (default: gpt-4o-mini)
# VCX_LLM_MODEL=gpt-4o-mini
# Max tokens for AI responses (default: 2000)
# VCX_LLM_MAX_TOKENS=2000

# --- CRM Integration (BloomlyTax VCX CRM) ------------------------------
# Webhook URL to forward leads to BloomlyTax CRM (POST /api/vcx/email/lead)
# If empty, CRM forwarding is silently skipped.
VCX_CRM_WEBHOOK_URL=
# Shared secret for webhook authentication (X-Webhook-Secret header)
VCX_CRM_WEBHOOK_SECRET=
# Business owner email for lead notifications
VCX_OWNER_EMAIL=stevenmiller@vitacorexllc.com

# --- Rate Limiting ------------------------------------------------------
# Set to "false" to disable all rate limiting (e.g., during load testing)
VCX_RATE_LIMIT_ENABLED=true
