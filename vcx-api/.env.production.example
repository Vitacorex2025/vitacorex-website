# =====================================================================
# vcx-api — PRODUCTION environment template (committable: placeholders only)
# These values go into the hosting dashboard (Render → service → Environment),
# never into the repository, chat, logs or the browser.
# Live payments work only when VCX_ENV=production AND VCX_PAYMENTS_MODE=stripe_live
# (the API refuses a live key in any other combination).
# =====================================================================

VCX_ENV=production

# --- Payments (Stripe Checkout) ---------------------------------------
VCX_PAYMENTS_MODE=stripe_live
# Restricted key created in Stripe (Live mode) → Developers → API keys → Create restricted key.
# Permissions: "Checkout Sessions" = Write. Everything else = None.
STRIPE_SECRET_KEY=<rk_live_… pasted by the owner in the hosting dashboard>
# Stripe → Developers → Webhooks → Add endpoint:
#   URL     https://<api host>/api/v2/stripe/webhook
#   Events  checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.async_payment_failed, checkout.session.expired
# Then reveal the endpoint's signing secret (whsec_…) and paste it here:
VCX_STRIPE_WEBHOOK_SECRET=<whsec_… pasted by the owner>

# --- URLs ---------------------------------------------------------------
VCX_SITE_BASE=https://vitacorexllc.com
VCX_API_BASE=https://<api host>
VCX_BASE_URL=https://vitacorexllc.com
VCX_ALLOWED_ORIGINS=https://vitacorexllc.com,https://www.vitacorexllc.com

# --- Storage: a persistent disk, or every order and payment record is lost on restart ---
VCX_DB_PATH=/var/data/vcx.db
VCX_UPLOADS_DIR=/var/data/uploads
VCX_MAX_UPLOAD_MB=25

# --- Other secrets (generate: python -c "import secrets; print(secrets.token_urlsafe(32))") ---
VCX_ADMIN_TOKEN=<random secret>
