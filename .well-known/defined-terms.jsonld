{
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "VitaCoreX Industry Glossary",
  "description": "Key terms in revenue recovery, pre-collection, and business documentation services.",
  "url": "https://vitacorexllc.com/",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "name": "Pre-Collection",
      "description": "Structured intervention on overdue accounts at 30-90 days before they are sent to a traditional collection agency. Pre-collection recovers 35-55 cents per dollar compared to 10-14 cents through agency placement.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Net Recovery Rate",
      "description": "The percentage of outstanding receivables that are successfully collected after all costs and fees. Pre-collection workflows improve net recovery by intervening earlier in the aging cycle.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "DSO (Days Sales Outstanding)",
      "description": "Average number of days a company takes to collect payment after a sale. Lower DSO indicates more efficient revenue collection. Pre-collection workflows typically reduce DSO by 15-37%.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Revenue Cycle Management (RCM)",
      "description": "The financial process that healthcare facilities use to track patient care episodes from registration through final payment. VitaCoreX provides pre-collection infrastructure for the recovery phase of RCM.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Dunning",
      "description": "The process of sending systematic payment reminders to customers with overdue accounts. Dunning optimization uses behavioral segmentation and timing to maximize recovery from failed payments.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Involuntary Churn",
      "description": "Customer loss caused by payment failures rather than deliberate cancellation. Structured dunning and payment recovery workflows can reduce involuntary churn by 20-40%.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Litigation-Ready Documentation",
      "description": "File packages organized with chronology, exhibits, payment records, and escalation history in a format ready for outside counsel review, reducing attorney administrative time.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "FDCPA (Fair Debt Collection Practices Act)",
      "description": "Federal law regulating third-party debt collection practices. VitaCoreX designs pre-collection workflows with FDCPA compliance as a guardrail.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Immigration Packet",
      "description": "Organized collection of forms, supporting evidence, identification documents, and filing instructions assembled for submission to USCIS for visa, green card, or naturalization applications.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "DSO (Dental Service Organization)",
      "description": "Management company that provides business support services to dental practices. VitaCoreX provides revenue recovery infrastructure designed for multi-location DSO operations.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    }
  ]
}
