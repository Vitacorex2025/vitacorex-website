{
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "VitaCoreX Glossary",
  "description": "Plain-language terms used on the VitaCoreX LLC website for documents, translations, notarization, apostilles, tax returns, company formation and small claims.",
  "url": "https://vitacorexllc.com/",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "name": "Certified translation",
      "description": "A complete translation of a document accompanied by the translator's signed certificate stating that the translation is complete and accurate.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Remote online notarization (RON)",
      "description": "A notarial act performed over audio-video communication, where the signer appears before the notary remotely, with identity verification and a session recording kept as required by state law.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Notarial act",
      "description": "A single act performed by a notary public, such as taking an acknowledgment or administering an oath or affirmation.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Apostille",
      "description": "A certificate under the 1961 Hague Apostille Convention that authenticates the origin of a public document for use in another member country. In the United States it is issued by the competent state authority for state documents or by the U.S. Department of State for federal documents.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Form 1040",
      "description": "U.S. Individual Income Tax Return, the federal income tax return filed by individuals with the IRS.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Schedule C",
      "description": "IRS form attached to Form 1040 to report profit or loss from a business operated as a sole proprietorship.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "EIN (Employer Identification Number)",
      "description": "A nine-digit federal tax identification number issued by the IRS to businesses. The IRS does not charge a fee to issue an EIN.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Articles of Organization",
      "description": "The document filed with a state to form a limited liability company (LLC).",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Form N-400",
      "description": "Application for Naturalization, filed with U.S. Citizenship and Immigration Services (USCIS) by lawful permanent residents applying for U.S. citizenship.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    },
    {
      "@type": "DefinedTerm",
      "name": "Small claims",
      "description": "A simplified state court process for civil claims up to a dollar limit set by each state. Rules on who may prepare documents and appear for a company differ by state and court.",
      "inDefinedTermSet": "https://vitacorexllc.com/"
    }
  ]
}
