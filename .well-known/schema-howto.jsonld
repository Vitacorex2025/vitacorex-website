    {
      "@type": "HowTo",
      "name": "How to book an online notarization with VitaCoreX",
      "description": "Remote online notarization by a Florida Notary Public by video. $25 per notarial act.",
      "estimatedCost": {"@type": "MonetaryAmount", "currency": "USD", "value": "25", "description": "per notarial act; additional acts, witnesses and printed copies are extra"},
      "url": "https://vitacorexllc.com/online-notary.html",
      "supply": [
        {"@type": "HowToSupply", "name": "The document to be notarized"},
        {"@type": "HowToSupply", "name": "A valid photo ID"}
      ],
      "tool": [
        {"@type": "HowToTool", "name": "A device with a camera and microphone"}
      ],
      "step": [
        {"@type": "HowToStep", "position": 1, "name": "Answer three quick questions", "text": "Tell us the document type, the number of signers and where the signer is located."},
        {"@type": "HowToStep", "position": 2, "name": "Pay and choose a time", "text": "Pay $25 for the notarial act and choose an appointment time."},
        {"@type": "HowToStep", "position": 3, "name": "Wait for the email confirmation", "text": "The appointment is confirmed by email once the calendar accepts it."},
        {"@type": "HowToStep", "position": 4, "name": "Join the video session", "text": "Verify your identity on the online platform and sign. You receive the electronic notarized document; the session recording is kept as required by Florida law."}
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to request apostille assistance",
      "description": "VitaCoreX finds the right authority for your document and destination country, prepares the submission and tracks it. From $119 service fee for the first document; government fees and shipping are separate.",
      "url": "https://vitacorexllc.com/apostille.html",
