        {"@type": "HowToStep", "position": 3, "name": "Upload documents securely", "text": "You receive a secure link for documents — never by email."},
        {"@type": "HowToStep", "position": 4, "name": "Review before filing", "text": "The return is reviewed with you before filing."}
      ]
