        {"@type": "HowToStep", "position": 3, "name": "Send the document", "text": "VitaCoreX prepares the request and cover letter for the correct state or federal authority."},
        {"@type": "HowToStep", "position": 4, "name": "Track the status", "text": "VitaCoreX tracks the submission and sends you status updates."}
      ]
