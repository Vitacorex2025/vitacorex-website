{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": "VitaCoreX LLC — FAQ",
  "description": "Questions about VitaCoreX LLC services and prices: translations, online notarization, apostille assistance, tax returns, company formation, business plans, document support, immigration forms and small claims for companies.",
  "url": "https://vitacorexllc.com/faq.html",
  "dateModified": "2026-10-14",
  "inLanguage": ["en", "ru", "es"],
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is VitaCoreX LLC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VitaCoreX LLC is a Tampa, Florida company that helps private clients with translations, online notarization, apostille assistance, individual tax returns, company formation, business plans, contracts and document tasks, and clerical immigration paperwork. A separate lane serves companies with small-claims document preparation. Service languages: English, Russian and Spanish."
      }
    },
    {
      "@type": "Question",
      "name": "Is VitaCoreX a law firm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. VitaCoreX LLC is not a law firm and does not provide legal advice or court representation. If you need a lawyer, VitaCoreX can pass a short summary to an independent licensed attorney only with your consent."
      }
    },
    {
      "@type": "Question",
      "name": "How much does online notarization cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$25 per notarial act. The session is a remote online notarization by a Florida Notary Public by video; you need a camera and a valid photo ID. Additional signatures or acts, witnesses, and a printed copy with mailing are extra."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a certified translation cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$25 per 250 source words (one standard page), with a signed translator certificate and PDF delivery. General translation without a certificate is $0.10 per source word with a $25 minimum order. Word count, price and date are confirmed before you pay."
      }
    },
    {
      "@type": "Question",
      "name": "How much does apostille assistance cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "From $119 service fee for the first document. Government apostille fees, shipping and courier are separate. You receive an itemized quote before paying."
      }
    },
    {
      "@type": "Question",
      "name": "How much does an individual tax return cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "From $149 for a simple federal return (Form 1040) for one tax year — final price after review. A state return is an add-on from $49. A self-employed return with one simple Schedule C starts from $249. Do not send SSNs or tax forms through the website form; documents are exchanged through a secure link."
      }
    },
    {
      "@type": "Question",
      "name": "How much does company formation cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$99 + state filing fee for the state and entity type you have chosen, or $199 + state filing fee including EIN application assistance (the IRS does not charge for an EIN). No subscription. Registered agent, annual reports, licenses, tax elections and legal advice are not included."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a business plan cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "From $499 for a defined basic plan: questionnaire and one working call, business model and market summary with sources, an assumption-based financial outline, an editable file and one revision. Investor, SBA or visa-specific plans are quoted separately."
      }
    },
    {
      "@type": "Question",
      "name": "Does VitaCoreX help with immigration forms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, clerically. VitaCoreX types a USCIS form that you or your adviser have chosen, checks it for completeness against the form instructions and organizes a document packet (from $149). N-400 document support starts from $249. Choosing a form, eligibility advice, interview preparation and representation are not provided. USCIS fees are separate."
      }
    },
    {
      "@type": "Question",
      "name": "Can I ask about my situation before choosing a service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Sending a request is free of charge. It is not a free legal consultation: VitaCoreX replies with a matching service and price, and paid work starts only after you accept a quote."
      }
    },
    {
      "@type": "Question",
      "name": "Does VitaCoreX help companies with small claims?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, per case, for one claim against one defendant: a small-claims filing packet from $199, one month of case support from $399, or a retainer (the full case with court representation under a power of attorney, where the court allows it) from $749 per case. Court hours are $65 per hour with a 2-hour minimum paid upfront. Court filing fees and service of process are separate; the state and court are confirmed before payment. Appeals and enforcement are not included; if a matter needs an attorney, we say so plainly."
      }
    },
    {
      "@type": "Question",
      "name": "Are government fees included in the price?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. State filing fees, apostille fees, USCIS fees, court fees, shipping and courier are separate and listed in the quote."
      }
    },
    {
      "@type": "Question",
      "name": "Сколько стоит онлайн-заверение документа?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$25 за одно нотариальное действие. Заверение проводит Florida Notary Public по видеосвязи; нужны камера и действующее удостоверение личности с фото. Дополнительные подписи или действия, свидетели, печатная копия и пересылка оплачиваются отдельно."
      }
    },
    {
      "@type": "Question",
      "name": "Помогает ли VitaCoreX с налоговой декларацией?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Да. Простая федеральная декларация физлица за один налоговый год — от $149, окончательная цена после проверки. Декларация штата — дополнение от $49, декларация для самозанятых с одним простым Schedule C — от $249."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta la notarización en línea?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$25 por acto notarial, por video ante un Florida Notary Public; necesita cámara e identificación vigente con foto. Las firmas o actos adicionales, los testigos y la copia impresa con envío se cobran aparte."
      }
    },
    {
      "@type": "Question",
      "name": "¿VitaCoreX ayuda con la apostilla?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. La gestión de apostilla cuesta desde $119 de tarifa de servicio por el primer documento. Las tasas gubernamentales y el envío se cobran aparte y se detallan en el presupuesto."
      }
    },
    {
      "@type": "Question",
      "name": "How do I contact VitaCoreX?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Call (888) 794-8292, email info@vitacorexllc.com, or send a request at vitacorexllc.com/request.html. VitaCoreX is based in Tampa, FL and works in English, Russian and Spanish."
      }
    }
  ]
}
